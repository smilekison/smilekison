# Copy to .env.microservices (gitignored) and fill in real values.
# Generate the RSA keypair + random secrets with:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});const e=s=>s.split('\n').join('\\\\n');console.log('AUTH_JWT_PRIVATE_KEY=\"'+e(privateKey)+'\"');console.log('AUTH_JWT_PUBLIC_KEY=\"'+e(publicKey)+'\"');console.log('INTERNAL_SERVICE_SECRET='+c.randomBytes(32).toString('hex'));console.log('DEPLOY_TARGET_ENCRYPTION_KEY='+c.randomBytes(32).toString('hex'));console.log('TWO_FACTOR_ENCRYPTION_KEY='+c.randomBytes(32).toString('hex'));console.log('SESSION_SECRET='+c.randomBytes(32).toString('hex'));"

# RS256 keypair auth-service signs with (private) and every other service
# verifies with (public). Never let the private key leave auth-service.
AUTH_JWT_PRIVATE_KEY="asdf"
AUTH_JWT_PUBLIC_KEY="qerqewr"

# Shared secret internal services use to sign/verify the short-lived
# (30s) service-to-service tokens the gateway attaches to every proxied call.
INTERNAL_SERVICE_SECRET="asfsdfaf"

# AES-256-GCM key deploy-service uses to encrypt SSH private keys at rest.
DEPLOY_TARGET_ENCRYPTION_KEY="iuyt"

# AES-256-GCM key auth-service uses to encrypt TOTP secrets at rest — has
# to be decryptable again to verify codes against, unlike the SHA-256
# hashes used for magic links/invites/recovery codes which never are.
TWO_FACTOR_ENCRYPTION_KEY="kjh"

# Signs nothing directly anymore (session is now the RS256 user JWT) — kept
# for services/utilities that still reference it during the web migration.
SESSION_SECRET="35151651"
